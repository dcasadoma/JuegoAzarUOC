<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#ECEFF1">

    <TextView
        android:id="@+id/tvGameCoins"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Saldo: 100 monedas"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        android:gravity="center"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:elevation="3dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/llReelsContainer"
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#263238"
        android:padding="12dp"
        android:elevation="6dp"
        app:layout_constraintTop_toBottomOf="@id/tvGameCoins"
        app:layout_constraintBottom_toTopOf="@id/tvResultMessage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivReel1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="6dp"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:src="@drawable/symbol_seven"
            android:contentDescription="Rodillo 1" />

        <ImageView
            android:id="@+id/ivReel2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="6dp"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:src="@drawable/symbol_seven"
            android:contentDescription="Rodillo 2" />

        <ImageView
            android:id="@+id/ivReel3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="6dp"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:src="@drawable/symbol_seven"
            android:contentDescription="Rodillo 3" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvResultMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="¡Pulsa TIRAR para probar suerte!\n(Coste: 10 monedas)"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#37474F"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/llReelsContainer"
        app:layout_constraintBottom_toTopOf="@id/btnSpin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnSpin"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:text="🎰 TIRAR RODILLOS (-10 MONEDAS)"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>